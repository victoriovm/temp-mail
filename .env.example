# Protege POST /api/receive, o painel /{SECRET_KEY} e as APIs administrativas.
# Use o mesmo valor no Bearer Token do Worker e um mínimo de 32 caracteres.
SECRET_KEY=secret-key

# Opcional. Sem esta variável, o desenvolvimento usa memória local.
REDIS_SERVER=redis://localhost:6379

# Domínios exibidos no frontend, separados por vírgula.
# Ao gerar um novo endereço, um deles será escolhido aleatoriamente.
NEXT_PUBLIC_MAIL_DOMAINS=example.com,example.net
